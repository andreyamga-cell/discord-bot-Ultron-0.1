@bot.command(name='mute')
async def mute_cmd(ctx, member: discord.Member, duration: str = None):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if member.id == MUTE_IMMUNE_USER_ID:
        await ctx.send("🛡️ Этот пользователь имеет иммунитет к муту!")
        return
    if antimute_enabled and member.id == ANTIMUTE_USER_ID:
        await ctx.send("🛡️ Защищён антимутом")
        return
    if member.id == PROTECTED_USER_ID:
        await ctx.send("❌ Нельзя заглушить защищённого")
        return
    if not member.voice or not member.voice.channel:
        await ctx.send("❌ Не в голосовом канале")
        return
    try:
        await member.edit(mute=True)
        embed = discord.Embed(title="🔇 Заглушен", color=0xff9900)
        embed.add_field(name="👤 Пользователь", value=member.mention, inline=True)
        embed.add_field(name="📢 Канал", value=member.voice.channel.name, inline=True)
        embed.add_field(name="👮 Модератор", value=ctx.author.mention, inline=True)
        if duration:
            embed.add_field(name="⏰", value=duration, inline=True)
        await ctx.send(embed=embed)
        await log_voice_action(ctx.guild, 'mute', member, ctx.author, member.voice.channel.name, duration)
        if should_log_user(ctx.author):
            add_user_action(ctx.author.id, 'voice_mute_issued',
                f"Заглушил {member.name}", target=member.id, channel=member.voice.channel.name)
        if duration:
            m = re.match(r'(\d+)([smhd])', duration.lower())
            if m:
                tv = int(m.group(1))
                tu = m.group(2)
                units = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}
                if tu in units:
                    total = tv * units[tu]
                    async def auto_unmute():
                        await asyncio.sleep(total)
                        try:
                            await member.edit(mute=False)
                            await ctx.send(f"🔊 {member.mention} автоматически разглушен")
                        except: pass
                    bot.loop.create_task(auto_unmute())
    except discord.Forbidden:
        await ctx.send("❌ Нет прав у бота")
    except Exception as e:
        await ctx.send(f"❌ Ошибка: {e}")


