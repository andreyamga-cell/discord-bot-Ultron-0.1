@bot.event
async def on_command_error(ctx, error):
    if isinstance(error, commands.CommandNotFound):
        return
    if isinstance(error, commands.MissingPermissions):
        await ctx.send(embed=discord.Embed(title="❌ Ошибка",
            description="Нет прав", color=0xff0000).set_image(url=ERROR_IMAGE_URL))
    elif isinstance(error, commands.MemberNotFound):
        await ctx.send(embed=discord.Embed(title="❌ Ошибка",
            description="Пользователь не найден", color=0xff0000))
    elif isinstance(error, commands.BadArgument):
        await ctx.send(embed=discord.Embed(title="❌ Ошибка",
            description="Неверный аргумент", color=0xff0000))
    else:
        logger.error(f"Ошибка команды: {error}")
        try:
            await ctx.send(embed=discord.Embed(title="❌ Ошибка",
                description=f"{error}", color=0xff0000))
        except:
            pass

