def create_backup():
    try:
        os.makedirs(BACKUP_DIR, exist_ok=True)
        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        subdir = os.path.join(BACKUP_DIR, ts)
        os.makedirs(subdir, exist_ok=True)
        files = [FARM_DATA_FILE, MEMBERS_FILE, TICKET_COUNTER_FILE, WARNINGS_FILE,
                 FARM_STATS_FILE, TOURNAMENT_COUNTER_FILE, MARRIAGE_FILE, TICKETS_DATA_FILE]
        for f in files:
            if os.path.exists(f):
                shutil.copy2(f, subdir)
        for folder in os.listdir(BACKUP_DIR):
            fp = os.path.join(BACKUP_DIR, folder)
            if os.path.isdir(fp):
                try:
                    ft = datetime.strptime(folder, '%Y%m%d_%H%M%S')
                    if (datetime.now() - ft).days > 7:
                        shutil.rmtree(fp)
                except:
                    pass
        return subdir
    except Exception as e:
        logger.error(f"Ошибка бэкапа: {e}")
        return None


def restore_backup(timestamp=None):
    try:
        if not os.path.exists(BACKUP_DIR):
            return False, "Папка бэкапов не найдена"
        backups = sorted([d for d in os.listdir(BACKUP_DIR)
                          if os.path.isdir(os.path.join(BACKUP_DIR, d))], reverse=True)
        if not backups:
            return False, "Нет бэкапов"
        target = timestamp if timestamp and timestamp in backups else backups[0]
        src = os.path.join(BACKUP_DIR, target)
        files = [FARM_DATA_FILE, MEMBERS_FILE, TICKET_COUNTER_FILE, WARNINGS_FILE,
                 FARM_STATS_FILE, TOURNAMENT_COUNTER_FILE, MARRIAGE_FILE, TICKETS_DATA_FILE]
        cnt = 0
        for f in files:
            s = os.path.join(src, f)
            if os.path.exists(s):
                shutil.copy2(s, f)
                cnt += 1
        return True, f"Восстановлено {cnt} файлов из {target}"
    except Exception as e:
        return False, f"Ошибка: {e}"


