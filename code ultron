def get_marriage_days(user_id):
    d = marriage_data.get(user_id)
    if not d or not d.get('married_at'):
        return 0
    return max(0, (datetime.now() - d['married_at']).days)

def format_marriage_days(user_id):
    days = get_marriage_days(user_id)
    if days == 0:
        return "меньше дня"
    y = days // 365
    m = (days % 365) // 30
    rd = (days % 365) % 30
    parts = []
    if y: parts.append(f"{y} г.")
    if m: parts.append(f"{m} мес.")
    if rd or not parts: parts.append(f"{rd} дн.")
    return " ".join(parts)

