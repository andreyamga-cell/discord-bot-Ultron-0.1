@bot.command(name='clear_warn')
async def clear_warning(ctx, member: discord.Member, level: int = None):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if member.id not in active_warnings or not active_warnings[member.id]:
        await ctx.send("❌ Нет предупреждений")
        return
    if level:
        warns = [w for w in active_warnings[member.id] if w['level'] == level]
        for w in warns:
            if w['end_time'] > datetime.now():
                role = discord.utils.get(ctx.guild.roles, name=WARNING_ROLES[level])
                if role and role in member.roles:
                    await member.remove_roles(role)
                active_warnings[member.id] = [x for x in active_warnings[member.id] if x['warning_id'] != w['warning_id']]
                save_warnings()
                await ctx.send(f"✅ Снято предупреждение уровня {level}")
                return
        await ctx.send("❌ Уже истекло")
    else:
        count = 0
        for w in active_warnings[member.id][:]:
            if w['end_time'] > datetime.now():
                role = discord.utils.get(ctx.guild.roles, name=WARNING_ROLES[w['level']])
                if role and role in member.roles:
                    await member.remove_roles(role)
                active_warnings[member.id].remove(w)
                count += 1
        if not active_warnings[member.id]:
            del active_warnings[member.id]
        save_warnings()
        await ctx.send(f"✅ Снято {count} предупреждений")

