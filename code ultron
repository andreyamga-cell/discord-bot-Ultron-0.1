class AddFarmInThreadView(discord.ui.View):
    def __init__(self, message_id, farm_type, target_member, creator):
        super().__init__(timeout=60)
        self.message_id = message_id
        self.farm_type = farm_type
        self.target_member = target_member
        self.creator = creator
        farm_config = FARM_TYPES[farm_type]
        for role_key, role_config in farm_config['roles'].items():
            button = discord.ui.Button(
                label=role_config['display_name'],
                style=discord.ButtonStyle.primary,
                emoji=role_config['emoji'],
                custom_id=f"addfarm_{role_key}"
            )
            button.callback = self.create_callback(role_key)
            self.add_item(button)
        cancel_button = discord.ui.Button(label="❌ Отмена", style=discord.ButtonStyle.danger)
        cancel_button.callback = self.cancel_callback
        self.add_item(cancel_button)

    def create_callback(self, role_key):
        async def callback(interaction: discord.Interaction):
            if interaction.user.id != self.creator.id:
                await interaction.response.send_message("❌ Это меню не для вас!", ephemeral=True)
                return
            if 'tank' in role_key:
                role_type = 'tank'
            elif 'support' in role_key:
                role_type = 'support'
            else:
                role_type = 'dps'
            dps_type = None
            if 'strong_dps' in role_key:
                dps_type = 'strong'
            elif 'weak_dps' in role_key:
                dps_type = 'weak'
            characters = get_filtered_characters(role_type, self.farm_type, dps_type)
            options = [discord.SelectOption(label=c, value=c) for c in characters[:25]]
            select = discord.ui.Select(placeholder="Выберите персонажа...", options=options, max_values=1)
            async def select_callback(select_interaction):
                await self.add_player_with_character(select_interaction, role_key, select.values[0])
            select.callback = select_callback
            view = discord.ui.View()
            view.add_item(select)
            await interaction.response.send_message(
                embed=discord.Embed(title="🎭 Выбор персонажа",
                    description=f"Выберите персонажа для {self.target_member.mention}", color=0x7289da),
                view=view, ephemeral=True)
        return callback

    async def add_player_with_character(self, interaction, role_key, character_name):
        if self.message_id not in farm_messages:
            await interaction.response.send_message("❌ Лист фарма неактивен", ephemeral=True)
            return
        event_data = farm_messages[self.message_id]['data']
        farm_config = FARM_TYPES[self.farm_type]
        if len(event_data[role_key]) >= farm_config['roles'][role_key]['limit']:
            await interaction.response.send_message("❌ Список заполнен", ephemeral=True)
            return
        for role_list in event_data.values():
            for entry in role_list:
                if entry['user'].id == self.target_member.id:
                    await interaction.response.send_message("❌ Уже записан", ephemeral=True)
                    return
        event_data[role_key].append({'user': self.target_member, 'character': character_name})
        save_farm_data()
        await interaction.response.send_message(
            f"✅ {self.target_member.mention} добавлен как {farm_config['roles'][role_key]['display_name']} ({character_name})",
            ephemeral=True)

    async def cancel_callback(self, interaction: discord.Interaction):
        if interaction.user.id != self.creator.id:
            await interaction.response.send_message("❌ Не для вас", ephemeral=True)
            return
        await interaction.response.edit_message(content="Отменено", view=None)

