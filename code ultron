@bot.command(name='addfarm')
async def addfarm_cmd(ctx, member: discord.Member = None):
    if not is_farm_creator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if not member:
        await ctx.send("❌ Укажите: `!addfarm @пользователь`")
        return
    if not isinstance(ctx.channel, discord.Thread):
        await ctx.send("❌ Только в тредах сборов!")
        return
    msg_id = None
    farm_type = None
    for mid, fd in farm_messages.items():
        if fd.get('thread_id') == ctx.channel.id:
            msg_id = mid
            farm_type = fd['type']
            break
    if not msg_id:
        await ctx.send("❌ Не найден лист фарма")
        return
    view = AddFarmInThreadView(msg_id, farm_type, member, ctx.author)
    await ctx.send(embed=discord.Embed(title="➕ Добавление",
                                       description=f"Выберите роль для {member.mention}", color=0x00ff00),
                   view=view)


@bot.command(name='removefarm')
async def removefarm_cmd(ctx, member: discord.Member = None):
    if not is_farm_creator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if not member:
        await ctx.send("❌ Укажите: !removefarm @пользователь")
        return
    if not isinstance(ctx.channel, discord.Thread):
        await ctx.send("❌ Только в тредах!")
        return
    msg_id = None
    for mid, fd in farm_messages.items():
        if fd.get('thread_id') == ctx.channel.id:
            msg_id = mid
            break
    if not msg_id:
        await ctx.send("❌ Не найден лист фарма")
        return
    event_data = farm_messages[msg_id]['data']
    farm_type = farm_messages[msg_id]['type']
    removed, removed_from, removed_data = await remove_specific_user_from_farm(event_data, member)
    if removed:
        try:
            message = await ctx.channel.fetch_message(msg_id)
            await update_farm_message(message, event_data, farm_type)
            save_farm_data()
