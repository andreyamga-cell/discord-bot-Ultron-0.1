async def update_announce_message(farm_message_id):
    """Обновляет анонс при изменении состава фарма (только для новой версии)"""
    if not SHOW_FREE_ROLES:
        return
    if farm_message_id not in farm_messages:
        return
    data = farm_messages[farm_message_id]
    announce_msg_id = data.get('announce_message_id')
    announce_ch_id = data.get('announce_channel_id')
    if not announce_msg_id or not announce_ch_id:
        return
    channel = bot.get_channel(announce_ch_id)
    if not channel:
        return
    try:
        msg = await channel.fetch_message(announce_msg_id)
    except:
        return
    farm_type = data['type']
    event_data = data['data']
    fc = FARM_TYPES[farm_type]
    time_str = data.get('event_time', '?')
    time_info = format_time_info(time_str) if time_str != '?' else None
