    if created_at.tzinfo is None:
        created_at = pytz.UTC.localize(created_at)
    acc_age_days = max(0, (now_utc - created_at).days)

    activity_text = "Нет"
    if getattr(member, 'activities', None):
        acts = [a.name for a in member.activities[:3] if getattr(a, 'name', None)]
        if acts:
            activity_text = ", ".join(acts)

    flags = []
    if member.bot:
        flags.append("🤖 Бот")
    pf = getattr(member, 'public_flags', None)
    if pf:
        if pf.staff:
            flags.append("Discord Staff")
        if pf.partner:
            flags.append("Partner")
        if pf.verified_bot_developer:
            flags.append("Verified Bot Dev")
        if pf.early_supporter:
            flags.append("Early Supporter")
        if pf.bug_hunter:
            flags.append("Bug Hunter")
        if pf.active_developer:
            flags.append("Active Developer")
        if pf.hypesquad_bravery:
            flags.append("HypeSquad Bravery")
        if pf.hypesquad_brilliance:
            flags.append("HypeSquad Brilliance")
        if pf.hypesquad_balance:
            flags.append("HypeSquad Balance")
    flags_text = ", ".join(flags) if flags else "Обычный аккаунт"

    mutual = len(member.mutual_guilds) if hasattr(member, 'mutual_guilds') else '—'
    roles = [r.mention for r in getattr(member, 'roles', [])[1:] if not r.is_default()]
    roles_text = ", ".join(roles[:20]) if roles else "Нет ролей"

    farm_info = "Нет данных"
    if member.id in farm_stats and farm_stats[member.id]:
        total = sum(farm_stats[member.id].values())
        chars = len(farm_stats[member.id])
        top_chars = sorted(farm_stats[member.id].items(), key=lambda x: x[1], reverse=True)[:3]
        top_text = ", ".join([f"{c} ({n})" for c, n in top_chars])
        farm_info = f"**Всего фармов:** {total}\n**Персонажей:** {chars}\n**Топ:** {top_text}"

    warns_info = "Нет"
    if member.id in active_warnings and active_warnings[member.id]:
        warns_info = "\n".join([f"• Ур. {w['level']}: {w['reason'][:50]}"
                                for w in active_warnings[member.id]])

    marriage_info = "Не в браке"
    mdata = marriage_data.get(member.id, {})
    if mdata.get('spouse'):
        sp_id = mdata['spouse']
        sp = member.guild.get_member(sp_id)
        days = get_marriage_days(member.id)
        marriage_info = f"💍 С {sp.mention if sp else f'<@{sp_id}>'} ({days} дн.)"
    if mdata.get('parents'):
        parents_str = ", ".join([f"<@{p}>" for p in mdata['parents']])
        marriage_info += f"\n👨‍👩‍👧 Родители: {parents_str}"
    if mdata.get('children'):
        children_str = ", ".join([f"<@{c}>" for c in mdata['children']])
        marriage_info += f"\n👶 Дети: {children_str}"

    msg_stats = user_stats.get(member.id, {})
    msgs = msg_stats.get('messages_sent', 0)

    joined_at = getattr(member, 'joined_at', None)
    if joined_at:
        if joined_at.tzinfo is None:
            joined_at = pytz.UTC.localize(joined_at)
        days_on = max(0, (now_utc - joined_at).days)
        joined_str = joined_at.astimezone(pytz.timezone('Europe/Moscow')).strftime('%d.%m.%Y %H:%M МСК')
    else:
        days_on = 0
        joined_str = '—'

    created_str = created_at.astimezone(pytz.timezone('Europe/Moscow')).strftime('%d.%m.%Y %H:%M МСК')
    created_ts = int(created_at.timestamp())
    avatar_url = member.display_avatar.url if member.display_avatar else None

    banner_url = None
    try:
        fetched = await bot.fetch_user(member.id)
        if fetched and fetched.banner:
            banner_url = fetched.banner.url
    except:
        if getattr(member, 'banner', None):
            banner_url = member.banner.url

    return {
        'name': member.name,
        'display_name': getattr(member, 'display_name', member.name),
        'id': member.id,
        'mention': member.mention,
        'avatar': avatar_url,
        'banner': banner_url,
        'acc_created': f"{created_str}\n(<t:{created_ts}:R> • {acc_age_days} дн.)",
        'acc_age': acc_age_days,
        'joined': joined_str,
        'days_on': days_on,
        'status': str(getattr(member, 'status', 'offline')).title(),
        'activity': activity_text,
        'flags': flags_text,
        'mutual': mutual,
        'roles': roles_text,
        'farm': farm_info,
        'warns': warns_info,
        'marriage': marriage_info,
        'messages': msgs
    }


