class MarriageProposalView(discord.ui.View):
    def __init__(self, proposer_id, target_id, proposal_type='marriage'):
        super().__init__(timeout=120)
        self.proposer_id = proposer_id
        self.target_id = target_id
        self.proposal_type = proposal_type

    @discord.ui.button(label="✅ Принять", style=discord.ButtonStyle.success, emoji="💍")
    async def accept(self, interaction, button):
        if interaction.user.id != self.target_id:
            await interaction.response.send_message("❌ Не для вас", ephemeral=True)
            return
        proposer = interaction.guild.get_member(self.proposer_id)
        if not proposer:
            await interaction.response.send_message("❌ Не найден", ephemeral=True)
            return
        if self.proposal_type == 'marriage':
            if marriage_data[interaction.user.id]['spouse']:
                await interaction.response.send_message("❌ Вы уже женаты", ephemeral=True)
                return
            if marriage_data[proposer.id]['spouse']:
                await interaction.response.send_message("❌ Партнёр уже женат", ephemeral=True)
                return
            now = datetime.now()
            marriage_data[interaction.user.id]['spouse'] = proposer.id
            marriage_data[interaction.user.id]['married_at'] = now
            marriage_data[proposer.id]['spouse'] = interaction.user.id
            marriage_data[proposer.id]['married_at'] = now
            save_marriage()
            embed = discord.Embed(title="💍 Свадьба состоялась!",
                description=f"{proposer.mention} 💞 {interaction.user.mention}\n\n"
                           f"**Дата:** {now.strftime('%d.%m.%Y %H:%M')}",
                color=0xff69b4, timestamp=now)
            await interaction.response.send_message(embed=embed)
            try:
                await proposer.send(f"💍 Вы женились на {interaction.user.mention}!")
                await interaction.user.send(f"💍 Вы вышли замуж/женились на {proposer.mention}!")
            except: pass
        elif self.proposal_type == 'adoption':
            if proposer.id in marriage_data[interaction.user.id]['parents']:
                await interaction.response.send_message("❌ Уже ребенок", ephemeral=True)
                return
            marriage_data[interaction.user.id]['parents'].append(proposer.id)
            marriage_data[proposer.id]['children'].append(interaction.user.id)
            sp = marriage_data[proposer.id].get('spouse')
            if sp and sp not in marriage_data[interaction.user.id]['parents']:
                marriage_data[interaction.user.id]['parents'].append(sp)
                marriage_data[sp]['children'].append(interaction.user.id)
            save_marriage()
            await interaction.response.send_message(embed=discord.Embed(
                title="👨‍👩‍👧 Усыновление!",
                description=f"{proposer.mention} усыновил(а) {interaction.user.mention}",
                color=0x00ff00))
        elif self.proposal_type == 'invite':
            if interaction.user.id in marriage_data[proposer.id]['children']:
                await interaction.response.send_message("❌ Уже в семье", ephemeral=True)
                return
            marriage_data[interaction.user.id]['parents'].append(proposer.id)
            marriage_data[proposer.id]['children'].append(interaction.user.id)
            sp = marriage_data[proposer.id].get('spouse')
            if sp:
                marriage_data[interaction.user.id]['parents'].append(sp)
                marriage_data[sp]['children'].append(interaction.user.id)
            save_marriage()
            await interaction.response.send_message(embed=discord.Embed(
                title="🎉 Приглашение принято!",
                description=f"{interaction.user.mention} теперь в семье {proposer.mention}",
                color=0x00ff00))
        for c in self.children: c.disabled = True
        try: await interaction.message.edit(view=self)
        except: pass

    @discord.ui.button(label="❌ Отклонить", style=discord.ButtonStyle.danger)
    async def decline(self, interaction, button):
        if interaction.user.id != self.target_id:
            await interaction.response.send_message("❌ Не для вас", ephemeral=True)
            return
        for c in self.children: c.disabled = True
        await interaction.response.send_message("❌ Отклонено", ephemeral=True)
        try: await interaction.message.edit(view=self)
        except: pass


def check_incest(user_id, target_id):
    """Проверка на инцест. Возвращает (bool, причина)"""
    ud = marriage_data[user_id]
    td = marriage_data[target_id]
    # Родитель?
    if target_id in ud.get('parents', []):
        return True, "Нельзя — это ваш родитель!"
    # Ребёнок?
    if target_id in ud.get('children', []):
        return True, "Нельзя — это ваш ребёнок!"
    # Брат/сестра (общие родители)?
    common = set(ud.get('parents', [])) & set(td.get('parents', []))
    if common:
        return True, "Нельзя — это ваш брат/сестра!"
    # Супруг родителя?
    for pid in ud.get('parents', []):
        if marriage_data[pid].get('spouse') == target_id:
            return True, "Нельзя — это супруг родителя!"
    # Родитель супруга?
    sp = ud.get('spouse')
    if sp and target_id in marriage_data[sp].get('parents', []):
        return True, "Нельзя — это родитель вашего супруга!"
    return False, ""


