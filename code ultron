def get_unix_timestamp(time_str):
    msk = pytz.timezone('Europe/Moscow')
    now = datetime.now(msk)
    try:
        h, m = map(int, time_str.split(':'))
        et = now.replace(hour=h, minute=m, second=0, microsecond=0)
        if et < now:
            et += timedelta(days=1)
        return int(et.astimezone(pytz.UTC).timestamp()), et
    except:
        return None, None

def format_time_info(time_str):
    ts, et = get_unix_timestamp(time_str)
    if ts:
        return {'full': f"<t:{ts}:F>", 'time': f"<t:{ts}:t>",
                'date': f"<t:{ts}:d>", 'relative': f"<t:{ts}:R>"}
    return None

