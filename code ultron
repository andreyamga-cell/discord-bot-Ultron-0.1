@bot.command(name='repeat')
async def repeat_cmd(ctx, count: int, interval: str, channel_id: int, *, message: str):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    m = re.match(r'(\d+)([smhd])', interval.lower())
    if not m:
        await ctx.send("❌ Формат: 30s, 30m, 1h, 1d")
        return
    tv = int(m.group(1))
    tu = m.group(2)
    units = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}
    total = tv * units[tu]
    channel = ctx.guild.get_channel(channel_id)
    if not channel:
        await ctx.send("❌ Канал не найден")
        return
    task_id = f"{ctx.author.id}_{datetime.now().timestamp()}"
    repeating_messages[task_id] = {
        'count': count, 'interval': total, 'channel_id': channel_id,
        'message': message, 'remaining': count, 'author': ctx.author.id
    }
    await ctx.send(f"🔄 Повтор: {count} раз каждые {interval} в {channel.mention}")
    bot.loop.create_task(execute_repeat(task_id, count, total, channel_id, message))


async def execute_repeat(task_id, count, interval, channel_id, message):
    try:
        g = bot.guilds[0] if bot.guilds else None
        if not g: return
        ch = g.get_channel(channel_id)
        if not ch: return
        for i in range(count):
            if task_id not in repeating_messages: break
            try:
                await ch.send(message)
                repeating_messages[task_id]['remaining'] = count - i - 1
                if i < count - 1:
                    await asyncio.sleep(interval)
            except: break
        if task_id in repeating_messages:
            del repeating_messages[task_id]
    except Exception as e:
        logger.error(f"Ошибка повтора: {e}")


