class AddPlayerModal(discord.ui.Modal, title="Добавление игрока"):
    user_id = discord.ui.TextInput(label="ID пользователя", placeholder="Введите Discord ID", required=True)

    def __init__(self, message_id, farm_type):
        super().__init__()
        self.message_id = message_id
        self.farm_type = farm_type

    async def on_submit(self, interaction):
        try:
            uid = int(self.user_id.value)
            member = interaction.guild.get_member(uid)
            if not member:
                await interaction.response.send_message(f"❌ {uid} не найден", ephemeral=True)
                return
            if self.message_id not in farm_messages:
                await interaction.response.send_message("❌ Фарм неактивен", ephemeral=True)
                return
            fc = FARM_TYPES[self.farm_type]
            options = []
            for rk, rc in fc['roles'].items():
                options.append(discord.SelectOption(label=rc['display_name'], value=rk, emoji=rc['emoji']))
            sel = discord.ui.Select(placeholder="Роль", options=options)

            async def cb(select_inter):
                role_key = sel.values[0]
                if 'tank' in role_key:
                    rt = 'tank'
                elif 'support' in role_key:
                    rt = 'support'
                else:
                    rt = 'dps'
                dps_type = None
                if 'strong_dps' in role_key:
                    dps_type = 'strong'
                elif 'weak_dps' in role_key:
                    dps_type = 'weak'
                chars = get_filtered_characters(rt, self.farm_type, dps_type)
                char_options = [discord.SelectOption(label=c, value=c) for c in chars[:25]]
                char_sel = discord.ui.Select(placeholder="Персонаж", options=char_options)

                async def char_cb(char_inter):
                    char_name = char_sel.values[0]
                    event_data = farm_messages[self.message_id]['data']
                    if len(event_data[role_key]) >= fc['roles'][role_key]['limit']:
                        await char_inter.response.send_message("❌ Заполнено", ephemeral=True)
                        return
                    for rl in event_data.values():
                        for e in rl:
                            if e['user'].id == member.id:
                                await char_inter.response.send_message("❌ Уже записан", ephemeral=True)
                                return
                    event_data[role_key].append({'user': member, 'character': char_name})
                    farm_stats[member.id][char_name] += 1
                    save_farm_stats()
                    save_farm_data()
                    try:
                        message = await char_inter.channel.fetch_message(self.message_id)
                        await update_farm_message(message, event_data, self.farm_type)
                    except:
                        pass
                    await char_inter.response.send_message("✅ Добавлен", ephemeral=True)
                    creator_id = farm_messages[self.message_id].get('creator_id')
                    creator = char_inter.guild.get_member(creator_id) if creator_id else None
                    await log_farm_action(char_inter.guild, 'join', member, char_name,
                                          fc['roles'][role_key]['display_name'], self.farm_type,
                                          fc['name'], creator=creator)
                    await update_announce_message(self.message_id)

                char_sel.callback = char_cb
                v2 = discord.ui.View()
                v2.add_item(char_sel)
                await select_inter.response.send_message("Выберите персонажа:", view=v2, ephemeral=True)

            sel.callback = cb
            v = discord.ui.View()
            v.add_item(sel)
            await interaction.response.send_message("Выберите роль:", view=v, ephemeral=True)
        except ValueError:
            await interaction.response.send_message("❌ Неверный ID", ephemeral=True)


class FarmUserManagementView(discord.ui.View):
    def __init__(self, message_id, farm_type):
        super().__init__(timeout=None)
        self.message_id = message_id
        self.farm_type = farm_type

    @discord.ui.button(label="➕ Добавить игрока", style=discord.ButtonStyle.success, emoji="➕")
    async def add_player(self, interaction, button):
        if self.message_id not in farm_messages:
            await interaction.response.send_message("❌ Не найден", ephemeral=True)
            return
        await interaction.response.send_modal(AddPlayerModal(self.message_id, self.farm_type))

    @discord.ui.button(label="❌ Удалить игрока", style=discord.ButtonStyle.danger, emoji="❌")
    async def remove_player(self, interaction, button):
        if self.message_id not in farm_messages:
            await interaction.response.send_message("❌ Не найден", ephemeral=True)
            return
        event_data = farm_messages[self.message_id]['data']
        players = []
        for rk, rl in event_data.items():
            for e in rl:
                players.append((e['user'], rk, e['character']))
        if not players:
            await interaction.response.send_message("❌ Нет игроков", ephemeral=True)
            return
        sel = discord.ui.Select(
            placeholder="Выберите игрока",
            options=[discord.SelectOption(label=p[0].display_name[:100],
                                          value=f"{p[0].id}_{p[1]}",
                                          description=f"{p[1]} - {p[2]}") for p in players[:25]])

        async def cb(select_inter):
            uid = int(sel.values[0].split('_')[0])
            for rk, rl in event_data.items():
                for i, e in enumerate(rl):
                    if e['user'].id == uid:
                        rl.pop(i)
                        break
            save_farm_data()
            try:
                message = await select_inter.channel.fetch_message(self.message_id)
                await update_farm_message(message, event_data, self.farm_type)
            except:
                pass
            await select_inter.response.send_message("✅ Удален", ephemeral=True)
            await update_announce_message(self.message_id)

        sel.callback = cb
        v = discord.ui.View()
        v.add_item(sel)
        await interaction.response.send_message("Выберите:", view=v, ephemeral=True)


