async def cleanup_messages_full(ctx, limit: int = 10):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if limit > 50:
        await ctx.send("❌ Максимум 50")
        return
    try:
        deleted = 0
        async for message in ctx.channel.history(limit=limit):
            if message.author == bot.user:
                await message.delete()
                deleted += 1
                await asyncio.sleep(0.5)
        msg = await ctx.send(f"✅ Удалено {deleted}")
        await asyncio.sleep(3)
        await msg.delete()
        if should_log_user(ctx.author):
            add_user_action(ctx.author.id, 'bot_cleanup',
                f"Удалил {deleted} сообщений бота", channel=ctx.channel.name)
    except Exception as e:
        await ctx.send(f"❌ {e}")


