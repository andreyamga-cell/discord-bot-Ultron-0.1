def is_moderator(ctx_or_user):
    user = ctx_or_user.author if hasattr(ctx_or_user, 'author') else ctx_or_user
    ctx = ctx_or_user if hasattr(ctx_or_user, 'author') else None

    if user.id in MODERATOR_USER_IDS or user.id == PROTECTED_USER_ID:
        return True

    if hasattr(user, 'roles'):
        for r in user.roles:
            if r.id in MODERATOR_ROLE_IDS or r.id == ADMIN_FULL_ROLE_ID:
                return True

    if ctx and getattr(ctx, 'guild', None):
        m = ctx.guild.get_member(user.id)
        if m:
            for r in m.roles:
                if r.id in MODERATOR_ROLE_IDS or r.id == ADMIN_FULL_ROLE_ID:
                    return True
            if m.guild_permissions.administrator:
                return True

    if hasattr(user, 'guild_permissions') and user.guild_permissions.administrator:
        return True
    return False


