# Обёртка для !warn_full с логами
@bot.command(name='warn_full')
async def warn_full_cmd(ctx, member: discord.Member, duration: str = "1h", *, reason: str = "Не указана"):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if member.id == PROTECTED_USER_ID:
        await ctx.send("❌ Нельзя выдать защищённому")
        return
    units = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}
    try:
        tv = int(duration[:-1])
        tu = duration[-1].lower()
        if tu not in units: raise ValueError
        total = tv * units[tu]
        end_time = datetime.now() + timedelta(seconds=total)
    except:
        await ctx.send("❌ Формат: 30s, 30m, 2h, 1d")
        return
    level = 1
    if member.id in active_warnings and active_warnings[member.id]:
        max_lvl = max(w['level'] for w in active_warnings[member.id])
        level = min(3, max_lvl + 1)
    role_name = WARNING_ROLES[level]
    role = discord.utils.get(ctx.guild.roles, name=role_name)
    if not role:
        await ctx.send(f"❌ Роль '{role_name}' не найдена")
        return
    warn_id = f"{member.id}_{level}_{datetime.now().timestamp()}"
    admin = discord.utils.get(ctx.guild.roles, name="Администратор")
    had_admin = admin and admin in member.roles
    if had_admin:
        await member.remove_roles(admin)
    await member.add_roles(role)
    active_warnings[member.id].append({
        'level': level, 'end_time': end_time, 'reason': reason,
        'role_name': role_name, 'issued_by': ctx.author.id,
        'issued_at': datetime.now(), 'warning_id': warn_id, 'had_admin': had_admin
    })
    bot.loop.create_task(remove_warning_after_delay(member, role, total, member.id, level, warn_id))
    save_warnings()
    if tu == 's': td = f"{tv} сек"
    elif tu == 'm': td = f"{tv} мин"
    elif tu == 'h': td = f"{tv} ч"
    elif tu == 'd': td = f"{tv} дн"
    active_warns = active_warnings[member.id]
    active_txt = "\n".join([f"• Ур. {w['level']} (ист. {w['end_time'].strftime('%d.%m.%Y %H:%M')})"
                            for w in active_warns])
    embed = discord.Embed(title="⚠️ Выдано предупреждение", color=0xff9900)
    embed.add_field(name="Пользователь", value=member.mention, inline=True)
    embed.add_field(name="Уровень", value=f"Предупреждение {level}", inline=True)
    embed.add_field(name="Длительность", value=td, inline=True)
    embed.add_field(name="Причина", value=reason, inline=False)
    embed.add_field(name="Истекает", value=end_time.strftime('%d.%m.%Y %H:%M:%S'), inline=True)
    embed.add_field(name="Активные", value=active_txt or "Нет", inline=False)
    embed.set_footer(text=f"Выдано: {ctx.author}")
    await ctx.send(embed=embed)
    if should_log_user(ctx.author):
        add_user_action(ctx.author.id, 'warn_issued',
            f"Выдал предупреждение ур. {level} пользователю {member.name}", target=member.id)
    if should_log_user(member):
        add_user_action(member.id, 'warn_received',
            f"Получил предупреждение ур. {level}: {reason}", target=ctx.author.id)
    await send_log(ctx.guild,
        f"⚠️ **Предупреждение**\n"
        f"**Пользователь:** {member.mention} ({member.name}) (ID: {member.id})\n"
        f"**Кто выдал:** {ctx.author.mention} ({ctx.author.name}) (ID: {ctx.author.id})\n"
        f"**Уровень:** {level}\n**Причина:** {reason}\n"
        f"**Длительность:** {td}\n"
        f"**Истекает:** {end_time.strftime('%d.%m.%Y %H:%M:%S')}\n"
        f"**Время:** {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}")
    try:
        remaining = end_time - datetime.now()
        total_sec = int(remaining.total_seconds())
        hours = total_sec // 3600
        minutes = (total_sec % 3600) // 60
        dm = discord.Embed(title="⚠️ Вам выдано предупреждение",
            description=f"**Уровень:** {level}\n**Причина:** {reason}",
            color=0xff9900, timestamp=datetime.now())
        dm.add_field(name="⏰ Длительность", value=td, inline=True)
        dm.add_field(name="📅 Истекает", value=end_time.strftime('%d.%m.%Y %H:%M:%S'), inline=True)
        dm.add_field(name="⏳ Осталось", value=f"{hours} ч. {minutes} мин.", inline=False)
        dm.add_field(name="👮 Выдал", value=ctx.author.mention, inline=False)
        dm.set_footer(text="Роль снимется автоматически")
        await member.send(embed=dm)
    except discord.Forbidden:
        await ctx.send("⚠️ Не удалось отправить DM (закрыты ЛС)")


