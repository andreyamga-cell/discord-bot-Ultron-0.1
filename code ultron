async def schedule_event_ping(guild, thread, message_id, time_str, farm_type):
    msk = pytz.timezone('Europe/Moscow')
    now = datetime.now(msk)
    try:
        h, m = map(int, time_str.split(':'))
        et = now.replace(hour=h, minute=m, second=0, microsecond=0)
        if et < now:
            et += timedelta(days=1)
        delay = (et - now).total_seconds()
        if delay > 0:
            bot.loop.create_task(ping_event_participants(guild, thread, message_id, farm_type, delay, time_str))
    except Exception as e:
        logger.error(f"Ошибка пинга: {e}")


async def ping_event_participants(guild, thread, message_id, farm_type, delay, time_str):
    try:
        await asyncio.sleep(delay)
        if message_id not in farm_messages:
            return
        event_data = farm_messages[message_id]['data']
        fc = FARM_TYPES[farm_type]
        all_p = []
        for rl in event_data.values():
            for e in rl:
                if e['user'] not in all_p:
                    all_p.append(e['user'])
        if all_p:
            mentions = " ".join([u.mention for u in all_p])
            await thread.send(f"🔔 **ВРЕМЯ ФАРМА!**\n\n{mentions}\n\n**Тип:** {fc['name']}")
        else:
            await thread.send("❌ Фарм отменён — никто не записался")
    except Exception as e:
        logger.error(f"Ошибка пинга: {e}")


