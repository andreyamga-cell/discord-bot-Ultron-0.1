# ---------- !remove_from_farm (ПОЛНАЯ) ----------
async def remove_from_farm_full(ctx, member: discord.Member, message_id: int = None):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if message_id is None:
        async for message in ctx.channel.history(limit=50):
            if message.author == bot.user and message.embeds and "Лист фарм лорд" in message.embeds[0].title:
                message_id = message.id
                break
        if message_id is None:
            await ctx.send("❌ Сообщение с записью не найдено")
            return
    if message_id in farm_messages:
        event_data = farm_messages[message_id]['data']
        farm_type = farm_messages[message_id]['type']
        removed, removed_from, removed_data = await remove_specific_user_from_farm(event_data, member)
        if removed:
            try:
                message = await ctx.channel.fetch_message(message_id)
                await update_farm_message(message, event_data, farm_type)
                save_farm_data()
                embed = discord.Embed(title="✅ Пользователь удален из записи", color=0x00ff00)
                embed.add_field(name="Пользователь", value=member.mention, inline=True)
                embed.add_field(name="Удален из", value=", ".join(removed_from), inline=True)
                await ctx.send(embed=embed)
                if removed_data:
                    farm_config = FARM_TYPES[farm_type]
                    role_name = removed_from[0].split('(')[0].strip() if removed_from else "неизвестно"
                    await log_farm_action(ctx.guild, 'leave', member,
                        removed_data['character'], role_name, farm_type, farm_config['name'])
                if should_log_user(ctx.author):
                    add_user_action(ctx.author.id, 'farm_user_removed',
                        f"Удалил {member.name} из записи на фарм",
                        target=member.id, channel=ctx.channel.name)
            except discord.NotFound:
                await ctx.send("❌ Сообщение не найдено")
        else:
            await ctx.send(f"❌ {member.mention} не найден в записи")
    else:
        await ctx.send("❌ Сообщение не найдено")


