class VerifyConfirmView(discord.ui.View):
    def __init__(self, ch_id=None, u_id=None):
        super().__init__(timeout=None)
        self.ch_id = ch_id
        self.u_id = u_id

    @discord.ui.button(label="✅ Да", style=discord.ButtonStyle.success, custom_id="verify_confirm_yes")
    async def yes(self, interaction, button):
        await interaction.response.defer()
        if not can_verify(interaction):
            await interaction.followup.send("❌ Нет прав", ephemeral=True)
            return
        ch_id = self.ch_id or interaction.channel.id
        channel = interaction.guild.get_channel(ch_id) or interaction.channel
        td = active_tickets.get(ch_id, {})
        u_id = self.u_id or td.get('user_id')
        user = interaction.guild.get_member(u_id) if u_id else None
        if not user:
            await interaction.followup.send("❌ Пользователь не найден", ephemeral=True)
            return
        vr = interaction.guild.get_role(VERIFY_ROLE_ID)
        vfr = interaction.guild.get_role(VERIFIED_ROLE_ID)
        if vfr:
            await user.add_roles(vfr)
        if vr and vr in user.roles:
            await user.remove_roles(vr)
        await channel.set_permissions(user, view_channel=False)
        arch = interaction.guild.get_channel(VERIFY_ARCHIVE_CATEGORY_ID)
        if arch:
            await channel.edit(category=arch)
        ign = td.get('ign') or 'unknown'
        try:
            await channel.edit(name=f"✅-{ign.lower().replace(' ', '-')[:50]}")
        except:
            pass
        await channel.send(f"✅ {user.mention} верифицирован модератором {interaction.user.mention}")
        if ch_id in active_tickets:
            del active_tickets[ch_id]
        save_active_tickets()
        for c in self.children:
            c.disabled = True
        await interaction.message.edit(view=self)
        await interaction.followup.send("✅ Готово", ephemeral=True)

    @discord.ui.button(label="❌ Нет", style=discord.ButtonStyle.danger, custom_id="verify_confirm_no")
    async def no(self, interaction, button):
        await interaction.response.defer()
        for c in self.children:
            c.disabled = True
        await interaction.message.edit(view=self)
        await interaction.followup.send("❌ Отменено", ephemeral=True)


