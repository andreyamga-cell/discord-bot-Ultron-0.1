    load_marriage()
    for guild in bot.guilds:
        for member in guild.members:
            if not member.bot:
                old_members[str(member.id)] = {
                    'name': member.name,
                    'display_name': member.display_name,
                    'joined_at': member.joined_at.isoformat() if member.joined_at else None,
                    'created_at': member.created_at.isoformat(),
                    'avatar_url': str(member.avatar.url) if member.avatar else None
                }
    save_members()
    if not update_time.is_running():
        update_time.start()
    if not update_stats.is_running():
        update_stats.start()
    if not auto_backup.is_running():
        auto_backup.start()
    for uid, warns in list(active_warnings.items()):
        member = bot.guilds[0].get_member(uid) if bot.guilds else None
        if not member:
            continue
        for w in warns[:]:
            if w['end_time'] <= datetime.now():
                active_warnings[uid].remove(w)
                continue
            role = discord.utils.get(bot.guilds[0].roles, name=w['role_name'])
            if role and role not in member.roles:
                await member.add_roles(role)
            delay = (w['end_time'] - datetime.now()).total_seconds()
            if delay > 0:
                bot.loop.create_task(remove_warning_after_delay(member, role, delay, uid, w['level'], w['warning_id']))
        if not active_warnings[uid]:
            del active_warnings[uid]
    if bot.guilds:
        try:
            await create_stats_channels(bot.guilds[0])
            await cleanup_old_stats_channels(bot.guilds[0])
        except: pass
    await send_initial_messages()
    await send_verification_message()
    await send_tournament_message()
    logger.info("✅ Готово")


