        if taken > 0:
            members_list = [f"<@{e['user'].id}>" for e in event_data[rk]]
            members = f"\n   └ {', '.join(members_list)}"
        lines.append(f"{emoji} **{name}** — {status}{members}")
    return "\n".join(lines)

