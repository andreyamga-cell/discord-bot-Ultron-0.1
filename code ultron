# ---------- ПОЛНЫЙ on_member_update ----------

@bot.event
async def on_member_update_full(before, after):
    """Полная версия с логами в канал"""
    if not should_log_user(before):
        return
    if before.display_name != after.display_name:
        add_user_action(before.id, 'nickname_change',
            f"Сменил ник с '{before.display_name}' на '{after.display_name}'")
        if str(before.id) in old_members:
            old_members[str(before.id)]['display_name'] = after.display_name
            save_members()
        issuer = None
        entry = await get_audit_log_entry(before.guild, discord.AuditLogAction.member_update, target=before)
        if entry and entry.user:
            issuer = entry.user
        issuer_text = f" (ID: {issuer.id})" if issuer else " (Неизвестно)"
        log_msg = (
            f"👤 **Изменён никнейм**\n"
            f"**Пользователь:** {after.mention} ({before.name}) (ID: {before.id})\n"
            f"**Было:** {before.display_name}\n"
            f"**Стало:** {after.display_name}\n"
            f"**Кто изменил:** {issuer.mention if issuer else 'Неизвестно'}{issuer_text}\n"
            f"**Время:** {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
        )
        await send_log(before.guild, log_msg)
    if before.roles != after.roles:
        added = [r for r in after.roles if r not in before.roles]
        removed = [r for r in before.roles if r not in after.roles]
        if added:
            role_names = ", ".join([r.name for r in added])
            add_user_action(before.id, 'role_added', f"Получил роли: {role_names}")
            issuer = None
            entry = await get_audit_log_entry(before.guild, discord.AuditLogAction.member_role_update, target=before)
            if entry and entry.user:
                issuer = entry.user
            issuer_text = f" (ID: {issuer.id})" if issuer else " (Неизвестно)"
            log_msg = (
                f"➕ **Выданы роли**\n"
                f"**Пользователь:** {after.mention} ({after.name}) (ID: {after.id})\n"
                f"**Роли:** {role_names}\n"
                f"**Кто выдал:** {issuer.mention if issuer else 'Неизвестно'}{issuer_text}\n"
                f"**Время:** {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
            )
            await send_log(after.guild, log_msg)
        if removed:
            role_names = ", ".join([r.name for r in removed])
            add_user_action(before.id, 'role_removed', f"Сняты роли: {role_names}")
            issuer = None
            entry = await get_audit_log_entry(before.guild, discord.AuditLogAction.member_role_update, target=before)
            if entry and entry.user:
                issuer = entry.user
            issuer_text = f" (ID: {issuer.id})" if issuer else " (Неизвестно)"
            log_msg = (
                f"➖ **Сняты роли**\n"
                f"**Пользователь:** {after.mention} ({after.name}) (ID: {after.id})\n"
                f"**Роли:** {role_names}\n"
                f"**Кто снял:** {issuer.mention if issuer else 'Неизвестно'}{issuer_text}\n"
                f"**Время:** {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
            )
            await send_log(after.guild, log_msg)


