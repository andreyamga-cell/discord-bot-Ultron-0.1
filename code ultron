class VerificationStartView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(label="🎫 Создать тикет", style=discord.ButtonStyle.primary, emoji="🎫", custom_id="verify_create_ticket_persistent")
    async def create(self, interaction, button):
        for cid, td in list(active_tickets.items()):
            if td['user_id'] == interaction.user.id:
                ch = interaction.guild.get_channel(cid)
                if ch:
                    await interaction.response.send_message(f"❌ У вас уже есть открытый тикет: {ch.mention}", ephemeral=True)
                    return
                else:
                    del active_tickets[cid]
        save_active_tickets()
        vfr = interaction.guild.get_role(VERIFIED_ROLE_ID)
        if vfr and vfr in interaction.user.roles:
            await interaction.response.send_message("✅ Вы уже верифицированы!", ephemeral=True)
            return
        global ticket_counter
        tn = f"тикет-{ticket_counter}"
        cat = interaction.guild.get_channel(VERIFY_CATEGORY_ID)
        ow = {
            interaction.guild.default_role: discord.PermissionOverwrite(view_channel=False),
            interaction.user: discord.PermissionOverwrite(view_channel=True, send_messages=True, read_message_history=True),
            interaction.guild.me: discord.PermissionOverwrite(view_channel=True, send_messages=True, read_message_history=True)
        }
        mvr = interaction.guild.get_role(MODERATOR_VERIFY_ROLE_ID)
        if mvr:
            ow[mvr] = discord.PermissionOverwrite(view_channel=True, send_messages=True, read_message_history=True)
        for mrid in MODERATOR_ROLE_IDS:
            mr = interaction.guild.get_role(mrid)
            if mr:
                ow[mr] = discord.PermissionOverwrite(view_channel=True, send_messages=True, read_message_history=True)
        tc = await interaction.guild.create_text_channel(name=tn, category=cat, overwrites=ow)
        active_tickets[tc.id] = {'user_id': interaction.user.id, 'ign': None, 'step': 'ign'}
        save_active_tickets()
        ticket_counter += 1
        save_ticket_counter()
        embed = discord.Embed(title="🎫 Тикет верификации",
                              description=f"Добро пожаловать, {interaction.user.mention}!", color=0x00ff00)
        embed.add_field(name="📝 Шаг 1",
                        value="Нажмите на кнопку ниже и укажите ваш никнейм в Marvel Rivals (кнопка не сгорает со временем).",
                        inline=False)
        await tc.send(content=interaction.user.mention, embed=embed, view=IGNInputView(tc.id))
        await interaction.response.send_message(f"✅ Тикет создан: {tc.mention}", ephemeral=True)
        await notify_owner(f"🎫 Создан новый тикет: {interaction.user.name}")


