async def send_initial_messages():
    channel = bot.get_channel(CHANNEL_ID)
    if not channel:
        logger.error(f"❌ Канал {CHANNEL_ID} не найден")
        return
    async for message in channel.history(limit=100):
        if message.author == bot.user:
            await message.delete()
    for region, tz in TIMEZONES.items():
        embed = create_time_embed(region, tz)
        message = await channel.send(embed=embed)
        message_ids[region] = message.id
    logger.info("✅ Время отправлено")

@tasks.loop(minutes=5)
async def update_time():
    channel = bot.get_channel(CHANNEL_ID)
    if not channel:
        return
    for region, tz in TIMEZONES.items():
        mid = message_ids.get(region)
        if mid:
            try:
                message = await channel.fetch_message(mid)
                await message.edit(embed=create_time_embed(region, tz))
            except discord.NotFound:
                message = await channel.send(embed=create_time_embed(region, tz))
                message_ids[region] = message.id
            except Exception as e:
                logger.error(f"Ошибка обновления времени {region}: {e}")

@tasks.loop(minutes=1)
async def update_stats():
    if bot.guilds:
        try:
            await update_stats_channels(bot.guilds[0])
        except Exception as e:
            logger.error(f"Ошибка статистики: {e}")

