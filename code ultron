def create_backup():
    """Создаёт резервную копию всех файлов данных"""
    try:
        os.makedirs(BACKUP_DIR, exist_ok=True)
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        backup_subdir = os.path.join(BACKUP_DIR, timestamp)
        os.makedirs(backup_subdir, exist_ok=True)
        files = [FARM_DATA_FILE, MEMBERS_FILE, TICKET_COUNTER_FILE, WARNINGS_FILE,
                 FARM_STATS_FILE, TOURNAMENT_COUNTER_FILE, MARRIAGE_FILE]
        copied = 0
        for f in files:
            if os.path.exists(f):
                shutil.copy2(f, backup_subdir)
                copied += 1
        logger.info(f"✅ Бэкап создан: {backup_subdir} ({copied} файлов)")
        # Удаляем старые бэкапы (старше 7 дней)
        for folder in os.listdir(BACKUP_DIR):
            folder_path = os.path.join(BACKUP_DIR, folder)
            if os.path.isdir(folder_path):
                try:
                    folder_time = datetime.strptime(folder, '%Y%m%d_%H%M%S')
                    if (datetime.now() - folder_time).days > 7:
                        shutil.rmtree(folder_path)
                        logger.info(f"🗑️ Удалён старый бэкап: {folder}")
                except:
                    pass
        return backup_subdir
    except Exception as e:
        logger.error(f"Ошибка создания бэкапа: {e}")
        return None

def restore_backup(timestamp=None):
    """Восстанавливает данные из последнего (или указанного) бэкапа"""
    try:
        if not os.path.exists(BACKUP_DIR):
            return False, "Папка бэкапов не найдена"
        backups = sorted([d for d in os.listdir(BACKUP_DIR)
                         if os.path.isdir(os.path.join(BACKUP_DIR, d))], reverse=True)
        if not backups:
            return False, "Нет доступных бэкапов"
        target = timestamp if timestamp and timestamp in backups else backups[0]
        source = os.path.join(BACKUP_DIR, target)
        files = [FARM_DATA_FILE, MEMBERS_FILE, TICKET_COUNTER_FILE, WARNINGS_FILE,
                 FARM_STATS_FILE, TOURNAMENT_COUNTER_FILE, MARRIAGE_FILE]
        restored = 0
        for f in files:
            src = os.path.join(source, f)
            if os.path.exists(src):
                shutil.copy2(src, f)
                restored += 1
        return True, f"Восстановлено {restored} файлов из бэкапа {target}"
    except Exception as e:
        return False, f"Ошибка восстановления: {e}"

