        super().__init__(timeout=60)
        self.message_id = message_id
        self.role_key = role_key
        self.characters = characters
        self.farm_type = farm_type
        options = [discord.SelectOption(label=c, value=c) for c in characters[:25]]
        sel = discord.ui.Select(placeholder="Выберите персонажа...", options=options, max_values=1)
        sel.callback = self.character_selected
        self.add_item(sel)

    async def character_selected(self, interaction):
        character_name = interaction.data['values'][0]
        if self.message_id not in farm_messages:
            await interaction.response.send_message("❌ Фарм неактивен", ephemeral=True)
            return
        event_data = farm_messages[self.message_id]['data']
        fc = FARM_TYPES[self.farm_type]
        if len(event_data[self.role_key]) >= fc['roles'][self.role_key]['limit']:
            await interaction.response.send_message("❌ Заполнено", ephemeral=True)
            return
        for rl in event_data.values():
            for entry in rl:
                if entry['user'].id == interaction.user.id:
                    await interaction.response.send_message("❌ Вы уже записаны!", ephemeral=True)
                    return
        event_data[self.role_key].append({'user': interaction.user, 'character': character_name})
        try:
            message = await interaction.channel.fetch_message(self.message_id)
            await update_farm_message(message, event_data, self.farm_type)
            role_display = fc['roles'][self.role_key]['display_name']
            await interaction.response.send_message(
                f"✅ Вы записаны как **{role_display}** ({character_name})", ephemeral=True)
            save_farm_data()
            # Лог в канал фарма
            creator_id = farm_messages[self.message_id].get('creator_id')
            creator = interaction.guild.get_member(creator_id) if creator_id else None
            await log_farm_action(interaction.guild, 'join', interaction.user,
                character_name, role_display, self.farm_type, fc['name'], creator=creator)
            # Обновить анонс
            await update_announce_message(self.message_id)
        except Exception as e:
            logger.error(f"Ошибка записи: {e}")
            await interaction.response.send_message("❌ Ошибка", ephemeral=True)


