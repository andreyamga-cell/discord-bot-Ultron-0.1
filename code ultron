async def update_announce_message(farm_message_id):
    if not SHOW_FREE_ROLES:
        return
    if farm_message_id not in farm_messages:
        return
    data = farm_messages[farm_message_id]
    announce_msg_id = data.get('announce_message_id')
    announce_ch_id = data.get('announce_channel_id')
    if not announce_msg_id or not announce_ch_id:
        return
    channel = bot.get_channel(announce_ch_id)
    if not channel:
        return
    try:
        msg = await channel.fetch_message(announce_msg_id)
    except:
        return
    farm_type = data['type']
    event_data = data['data']
    fc = FARM_TYPES[farm_type]
    time_str = data.get('event_time', '?')
    time_info = format_time_info(time_str) if time_str != '?' else None
    creator_id = data.get('creator_id')
    creator = channel.guild.get_member(creator_id) if creator_id else None
    thread_id = data.get('thread_id')
    embed = discord.Embed(title="🎯 СБОР НА ФАРМ", color=0x00ff00, timestamp=datetime.now())
    embed.add_field(name="⏰ Время", value=f"**{time_str} МСК**", inline=True)
    if time_info:
        embed.add_field(name="📅 Дата", value=time_info['full'], inline=True)
        embed.add_field(name="⏳ До начала", value=time_info['relative'], inline=True)
    embed.add_field(name="⚔️ Тип", value=f"**{fc['name']}**", inline=False)
    embed.add_field(name="🟢 Свободные роли", value=format_free_roles(event_data, farm_type), inline=False)
    thread_mention = f"<#{thread_id}>" if thread_id else "—"
    embed.add_field(name="📝 Запись", value=f"Для записи: {thread_mention}", inline=False)
    if creator:
        embed.add_field(name="👑 Создал", value=creator.mention, inline=False)
    try:
        await msg.edit(embed=embed)
    except Exception as e:
        logger.error(f"Ошибка обновления анонса: {e}")


async def create_farm_event(interaction, time_str, farm_type):
    fc = FARM_TYPES[farm_type]
    farm_mention_role = interaction.guild.get_role(FARM_MENTION_ROLE_ID)
    mention_text = farm_mention_role.mention if farm_mention_role else "@Фарм лорда"
    time_info = format_time_info(time_str)
    message_content = (
        f"# **СБОР НА ФАРМ**\n\n"
        f"**⏰ Время:** {time_str} МСК\n"
        f"**📅 Дата и время:** {time_info['full'] if time_info else time_str}\n"
        f"**⏳ До начала:** {time_info['relative'] if time_info else 'Неизвестно'}\n"
        f"**⚔️ Тип: {fc['name']}**\n\n"
        f"**📢 Участники**\n{mention_text} - присоединяйтесь!\n\n"
        f"**📝 Запись открыта!**"
    )
    main_message = await interaction.channel.send(content=message_content)
    thread = await main_message.create_thread(
        name=f"⚔️ Фарм {time_str} - {fc['name']}",
        auto_archive_duration=1440)
    event_data = {rk: [] for rk in fc['roles'].keys()}
    farm_embed = create_farm_embed(event_data, farm_type)
    first_role_key = next(iter(fc['roles'].keys()))
    if 'team1_' in first_role_key:
        view = TeamFarmRoleSelectionView(0, farm_type)
    else:
        view = RoleSelectionView(0, farm_type)
    farm_message = await thread.send(embed=farm_embed, view=view)
    view.message_id = farm_message.id
    farm_messages[farm_message.id] = {
        'data': event_data, 'type': farm_type, 'thread_id': thread.id,
        'event_time': time_str, 'main_message_id': main_message.id,
        'creator_id': interaction.user.id
    }
    save_farm_data()
    await schedule_event_ping(interaction.guild, thread, farm_message.id, time_str, farm_type)
    announce_channel = bot.get_channel(FARM_ANNOUNCE_CHANNEL_ID)
    if announce_channel:
        if SHOW_FREE_ROLES:
            embed = discord.Embed(title="🎯 СБОР НА ФАРМ", color=0x00ff00, timestamp=datetime.now())
            embed.add_field(name="⏰ Время", value=f"**{time_str} МСК**", inline=True)
            if time_info:
                embed.add_field(name="📅 Дата", value=time_info['full'], inline=True)
                embed.add_field(name="⏳ До начала", value=time_info['relative'], inline=True)
            embed.add_field(name="⚔️ Тип", value=f"**{fc['name']}**", inline=False)
            embed.add_field(name="🟢 Свободные роли", value=format_free_roles(event_data, farm_type), inline=False)
            embed.add_field(name="📝 Запись",
                            value=f"Для записи: {thread.mention}\n**[Ссылка]({farm_message.jump_url})**",
                            inline=False)
            embed.add_field(name="👑 Создал",
                            value=f"{interaction.user.mention} • {datetime.now().strftime('%d.%m.%Y %H:%M')}",
                            inline=False)
            announce_msg = await announce_channel.send(
                content=f"<@&{FARM_MENTION_ROLE_ID}>", embed=embed)
            farm_messages[farm_message.id]['announce_message_id'] = announce_msg.id
            farm_messages[farm_message.id]['announce_channel_id'] = announce_channel.id
            save_farm_data()
        else:
            current_msk = await get_current_msk_time_from_channel()
            current_time_text = f"\n**🕐 Текущее время МСК:** {current_msk}" if current_msk else ""
            announce_content = (
                f"# **СБОР НА ФАРМ**\n\n"
