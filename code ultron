def save_marriage():
    try:
        serializable = {}
        for user_id, data in marriage_data.items():
            serializable[user_id] = {
                'spouse': data.get('spouse'),
                'married_at': data.get('married_at').isoformat() if data.get('married_at') else None,
                'children': data.get('children', []),
                'parents': data.get('parents', [])
            }
        with open(MARRIAGE_FILE, 'wb') as f:
            pickle.dump(serializable, f)
        logger.info("Данные брака сохранены")
    except Exception as e:
        logger.error(f"Ошибка сохранения данных брака: {e}")

def load_marriage():
    global marriage_data
    try:
        if os.path.exists(MARRIAGE_FILE):
            with open(MARRIAGE_FILE, 'rb') as f:
                data = pickle.load(f)
                for user_id, d in data.items():
                    marriage_data[int(user_id)] = {
                        'spouse': d.get('spouse'),
                        'married_at': datetime.fromisoformat(d['married_at']) if d.get('married_at') else None,
                        'children': d.get('children', []),
                        'parents': d.get('parents', [])
                    }
