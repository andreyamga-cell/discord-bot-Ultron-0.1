def get_marriage_days(user_id):
    data = marriage_data.get(user_id)
    if not data or not data.get('married_at'):
        return 0
    delta = datetime.now() - data['married_at']
    return max(0, delta.days)

def format_marriage_days(user_id):
    days = get_marriage_days(user_id)
    if days == 0:
        return "меньше дня"
    years = days // 365
    months = (days % 365) // 30
    rem_days = (days % 365) % 30
    parts = []
    if years: parts.append(f"{years} г.")
    if months: parts.append(f"{months} мес.")
    if rem_days or not parts: parts.append(f"{rem_days} дн.")
    return " ".join(parts)

