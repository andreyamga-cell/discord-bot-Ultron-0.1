async def clear_chat_full(ctx, amount: int = 10):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if amount < 1 or amount > 100:
        await ctx.send("❌ Укажите 1-100")
        return
    try:
        deleted = await ctx.channel.purge(limit=amount + 1)
        if should_log_user(ctx.author):
            add_user_action(ctx.author.id, 'chat_cleared',
                f"Очистил {len(deleted)-1} сообщений в #{ctx.channel.name}",
                channel=ctx.channel.name)
        embed = discord.Embed(title="✅ Чат очищен",
            description=f"Удалено **{len(deleted)-1}** сообщений",
            color=0x00ff00, timestamp=datetime.now())
        embed.add_field(name="👮 Модератор", value=ctx.author.mention, inline=True)
        embed.add_field(name="📊 Кол-во", value=str(len(deleted)-1), inline=True)
        embed.add_field(name="📝 Канал", value=ctx.channel.mention, inline=True)
        msg = await ctx.send(embed=embed)
        await asyncio.sleep(5)
        await msg.delete()
        log_message = (
            f"🧹 **Очистка чата**\n"
            f"**Модератор:** {ctx.author.mention} ({ctx.author.name}) (ID: {ctx.author.id})\n"
            f"**Канал:** #{ctx.channel.name}\n"
            f"**Количество:** {len(deleted)-1}\n"
            f"**Время:** {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
        )
        await send_log(ctx.guild, log_message)
    except Exception as e:
        await ctx.send(f"❌ {e}")


