# ---------- !warn (ПОЛНАЯ С ЛОГАМИ И DM) ----------
# Переопределяем через отдельное имя, чтобы не конфликтовать
# (в Discord.py @bot.command с одним именем перезаписывает; используем name='warn2' как альтернативу)
# При желании удали старую команду warn и переименуй эту в warn.

async def warn_user_full(ctx, member: discord.Member, duration: str = "1h", *, reason: str = "Не указана"):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if member.id == PROTECTED_USER_ID:
        await ctx.send("❌ Этому пользователю нельзя выдать предупреждение!")
        return
    units = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}
    try:
        tv = int(duration[:-1])
        tu = duration[-1].lower()
        if tu not in units:
            raise ValueError
        total = tv * units[tu]
        end_time = datetime.now() + timedelta(seconds=total)
    except:
        await ctx.send("❌ Формат: 30s, 30m, 2h, 1d")
        return
    level = 1
    if member.id in active_warnings and active_warnings[member.id]:
        max_lvl = max(w['level'] for w in active_warnings[member.id])
        level = min(3, max_lvl + 1)
    role_name = WARNING_ROLES[level]
    role = discord.utils.get(ctx.guild.roles, name=role_name)
    if not role:
        await ctx.send(f"❌ Роль '{role_name}' не найдена")
        return
    warn_id = f"{member.id}_{level}_{datetime.now().timestamp()}"
    admin_role = discord.utils.get(ctx.guild.roles, name="Администратор")
    had_admin = admin_role and admin_role in member.roles
    if had_admin:
        await member.remove_roles(admin_role)
    await member.add_roles(role)
    active_warnings[member.id].append({
        'level': level, 'end_time': end_time, 'reason': reason,
        'role_name': role_name, 'issued_by': ctx.author.id,
        'issued_at': datetime.now(), 'warning_id': warn_id, 'had_admin': had_admin
    })
    bot.loop.create_task(remove_warning_after_delay(
        member, role, total, member.id, level, warn_id))
    save_warnings()
    time_display = f"{tv}{tu}"
    if tu == 's': time_display = f"{tv} секунд"
    elif tu == 'm': time_display = f"{tv} минут"
    elif tu == 'h': time_display = f"{tv} часов"
    elif tu == 'd': time_display = f"{tv} дней"
    active_warns = active_warnings[member.id]
    active_warns_text = "\n".join([f"• Уровень {w['level']} (истекает {w['end_time'].strftime('%d.%m.%Y %H:%M:%S')})"
                                   for w in active_warns])
    embed = discord.Embed(title="⚠️ Выдано предупреждение", color=0xff9900)
    embed.add_field(name="Пользователь", value=member.mention, inline=True)
    embed.add_field(name="Уровень", value=f"Предупреждение {level}", inline=True)
    embed.add_field(name="Длительность", value=time_display, inline=True)
    embed.add_field(name="Причина", value=reason, inline=False)
    embed.add_field(name="Истекает", value=end_time.strftime("%d.%m.%Y %H:%M:%S"), inline=True)
    embed.add_field(name="Активные", value=active_warns_text or "Нет", inline=False)
    embed.set_footer(text=f"Выдано: {ctx.author}")
    await ctx.send(embed=embed)
    if should_log_user(ctx.author):
        add_user_action(ctx.author.id, 'warn_issued',
            f"Выдал предупреждение уровня {level} пользователю {member.name}",
            target=member.id)
    if should_log_user(member):
        add_user_action(member.id, 'warn_received',
            f"Получил предупреждение уровня {level}: {reason}",
            target=ctx.author.id)
    log_message = (
        f"⚠️ **Выдано предупреждение**\n"
        f"**Пользователь:** {member.mention} ({member.name}) (ID: {member.id})\n"
        f"**Кто выдал:** {ctx.author.mention} ({ctx.author.name}) (ID: {ctx.author.id})\n"
        f"**Уровень:** {level}\n**Причина:** {reason}\n"
        f"**Длительность:** {time_display}\n"
        f"**Истекает:** {end_time.strftime('%d.%m.%Y %H:%M:%S')}\n"
        f"**Время:** {datetime.now().strftime('%d.%m.%Y %H:%M:%S')}"
    )
    await send_log(ctx.guild, log_message)
    try:
        await member.send(f"⚠️ Вам выдано предупреждение уровня {level} на {time_display}\n"
            f"**Причина:** {reason}\n"
            f"**Истекает:** {end_time.strftime('%d.%m.%Y %H:%M:%S')}\n\n"
            f"Роль снимется автоматически.")
    except:
        pass


# ---------- !mute (ПОЛНАЯ С AUTO_UNMUTE) ----------
async def voice_mute_full(ctx, member: discord.Member, duration: str = None):
    if not is_moderator(ctx):
        await ctx.send("❌ Нет прав")
        return
    if antimute_enabled and member.id == ANTIMUTE_USER_ID:
        await ctx.send("🛡️ Защищён антимутом")
        return
    if member.id == PROTECTED_USER_ID:
        await ctx.send("❌ Нельзя заглушить")
        return
    if not member.voice or not member.voice.channel:
        await ctx.send("❌ Не в голосовом")
        return
    try:
        await member.edit(mute=True)
        embed = discord.Embed(title="🔇 Пользователь заглушен", color=0xff9900, timestamp=datetime.now())
        embed.add_field(name="👤 Пользователь", value=member.mention, inline=True)
        embed.add_field(name="📢 Канал", value=member.voice.channel.name, inline=True)
        embed.add_field(name="👮 Модератор", value=ctx.author.mention, inline=True)
        if duration:
            embed.add_field(name="⏰ Длительность", value=duration, inline=True)
        await ctx.send(embed=embed)
        await log_voice_action(ctx.guild, 'mute', member, ctx.author, member.voice.channel.name, duration)
        if should_log_user(ctx.author):
            add_user_action(ctx.author.id, 'voice_mute_issued',
                f"Заглушил {member.name}",
                target=member.id, channel=member.voice.channel.name)
        if duration:
            time_pattern = re.compile(r'(\d+)([smhd])')
            match = time_pattern.match(duration.lower())
            if match:
                tv = int(match.group(1))
                tu = match.group(2)
                tu_map = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}
                if tu in tu_map:
                    total = tv * tu_map[tu]
                    async def auto_unmute():
                        await asyncio.sleep(total)
                        try:
                            await member.edit(mute=False)
                            await ctx.send(f"🔊 {member.mention} автоматически разглушен")
                            await log_voice_action(ctx.guild, 'unmute', member, ctx.author,
                                member.voice.channel.name if member.voice else None, "Авто")
                        except:
                            pass
                    bot.loop.create_task(auto_unmute())
    except discord.Forbidden:
        await ctx.send("❌ Нет прав у бота")
    except Exception as e:
        await ctx.send(f"❌ Ошибка: {e}")


