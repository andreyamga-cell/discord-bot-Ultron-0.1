# ---------- MembersPaginationView + MemberSearchModal ----------
class MembersPaginationView(discord.ui.View):
    def __init__(self, members_list, page, total_pages, per_page=10):
        super().__init__(timeout=120)
        self.members_list = members_list
        self.current_page = page
        self.total_pages = total_pages
        self.per_page = per_page

    @discord.ui.button(label="◀️ Назад", style=discord.ButtonStyle.secondary, custom_id="prev_members")
    async def prev_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        if self.current_page > 1:
            self.current_page -= 1
            await self.update_message(interaction)

    @discord.ui.button(label="➡️ Вперед", style=discord.ButtonStyle.secondary, custom_id="next_members")
    async def next_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        if self.current_page < self.total_pages:
            self.current_page += 1
            await self.update_message(interaction)

    @discord.ui.button(label="🔍 Поиск", style=discord.ButtonStyle.primary, custom_id="search_members")
    async def search_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_modal(MemberSearchModal())

    @discord.ui.button(label="🚪 Закрыть", style=discord.ButtonStyle.danger, custom_id="close_members")
    async def close_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.message.delete()

    async def update_message(self, interaction: discord.Interaction):
        start = (self.current_page - 1) * self.per_page
        end = start + self.per_page
        page_members = self.members_list[start:end]
        embed = discord.Embed(
            title=f"📜 Список участников (Страница {self.current_page}/{self.total_pages})",
            description=f"Всего сохранено: {len(self.members_list)}",
            color=0x00ff00, timestamp=datetime.now())
        for mid, mdata in page_members:
            name = mdata.get('display_name') or mdata.get('name', 'Неизвестно')
            joined = mdata.get('joined_at', 'Неизвестно')
            if joined != 'Неизвестно':
                try:
                    joined = datetime.fromisoformat(joined).strftime('%d.%m.%Y')
                except:
                    pass
            embed.add_field(name=f"👤 {name}",
                value=f"**ID:** {mid}\n**На сервере с:** {joined}\n**Упоминание:** <@{mid}>",
                inline=False)
        embed.set_footer(text=f"Страница {self.current_page}/{self.total_pages}")
        await interaction.response.edit_message(embed=embed, view=self)


