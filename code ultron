        emoji = rc['emoji']
        name = rc['display_name']
        if free == 0:
            status = "🔴 ЗАПОЛНЕНО"
        elif taken == 0:
            status = f"🟢 Свободно: {free}/{limit}"
        else:
            status = f"🟡 Свободно: {free}/{limit}"
