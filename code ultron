class VerifyConfirmView(discord.ui.View):
    def __init__(self, ch_id, u_id):
        super().__init__(timeout=120)
        self.ch_id = ch_id
        self.u_id = u_id

    @discord.ui.button(label="✅ Да", style=discord.ButtonStyle.success)
    async def yes(self, interaction, button):
        await interaction.response.defer()
        if not can_verify(interaction):
            await interaction.followup.send("❌ Нет прав", ephemeral=True)
            return
        channel = interaction.guild.get_channel(self.ch_id)
        user = interaction.guild.get_member(self.u_id)
        if not user:
            await interaction.followup.send("❌ Не найден", ephemeral=True)
            return
        vr = interaction.guild.get_role(VERIFY_ROLE_ID)
        vfr = interaction.guild.get_role(VERIFIED_ROLE_ID)
        if vfr: await user.add_roles(vfr)
        if vr and vr in user.roles: await user.remove_roles(vr)
        await channel.set_permissions(user, view_channel=False)
        arch = interaction.guild.get_channel(VERIFY_ARCHIVE_CATEGORY_ID)
        if arch: await channel.edit(category=arch)
        td = active_tickets.get(self.ch_id, {})
        ign = td.get('ign', 'unknown')
        try: await channel.edit(name=f"✅-{ign.lower().replace(' ', '-')[:50]}")
        except: pass
        await channel.send(f"✅ {user.mention} верифицирован")
        if self.ch_id in active_tickets: del active_tickets[self.ch_id]
        for c in self.children: c.disabled = True
        await interaction.message.edit(view=self)
        await interaction.followup.send("✅ Готово", ephemeral=True)

    @discord.ui.button(label="❌ Нет", style=discord.ButtonStyle.danger)
    async def no(self, interaction, button):
        await interaction.response.defer()
        for c in self.children: c.disabled = True
        await interaction.message.edit(view=self)
        await interaction.followup.send("❌ Отменено", ephemeral=True)


